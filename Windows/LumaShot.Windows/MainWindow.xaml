<Window x:Class="LumaShot.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="拾光截图 · LumaShot" Width="1180" Height="850" MinWidth="980" MinHeight="700" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#FBFBFE" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="22,32,18,22">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,42">
            <Image Source="/Assets/AppIcon.png" Width="45" Height="45" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="拾光截图" FontWeight="Bold" FontSize="21"/><TextBlock Text="L U M A S H O T" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
          </StackPanel>
          <TextBlock Text="工作空间" FontSize="11" Foreground="{StaticResource Muted}" Margin="12,0,0,10"/>
          <Button x:Name="CaptureNav" Style="{StaticResource SideButton}" Click="ShowCapture" Content="▣    开始截图"/>
          <Button x:Name="HistoryNav" Style="{StaticResource SideButton}" Click="ShowHistory" Content="▱    截图历史"/>
          <Button x:Name="SettingsNav" Style="{StaticResource SideButton}" Click="ShowSettings" Content="☷    偏好设置"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,20">
            <StackPanel><TextBlock Text="●  随时待命，轻按即截" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="关闭窗口后，仍可通过托盘或快捷键快速唤起。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="21" Margin="0,10,0,8"/><TextBlock Text="Ctrl + Shift + 1" Foreground="{StaticResource Accent}" FontSize="12"/></StackPanel>
          </Border>
          <TextBlock Text="♧  只在本地，安心记录" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
        </StackPanel>
        <Grid/>
      </DockPanel>
    </Border>
    <DockPanel Grid.Column="1" Margin="36,28,36,18">
      <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><TextBlock x:Name="StatusLabel" Text="准备好捕捉灵感" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="LUMASHOT / WINDOWS" Foreground="#ACB1C2" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
      <Border x:Name="ConflictBanner" DockPanel.Dock="Top" Background="#FFF1DE" CornerRadius="10" Padding="12" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock x:Name="ConflictText" TextWrapping="Wrap" Foreground="#8D6223" FontSize="12"/></Border>
      <Grid>
        <ScrollViewer x:Name="CapturePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,0">
            <DockPanel Margin="0,0,0,28">
              <Button DockPanel.Dock="Right" Content="＋  打开图片" Click="ImportImage" VerticalAlignment="Top" Margin="15,12,0,0"/>
              <StackPanel><TextBlock Text="MAKE A LITTLE SPACE FOR INSPIRATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/><TextBlock Text="截下此刻，留住灵感。" FontSize="32" FontWeight="Bold"/><TextBlock Text="从捕捉到表达，几步就好。" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel>
            </DockPanel>
            <Border CornerRadius="22" Padding="30" Margin="0,0,0,28">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EDE7FF" Offset="0"/><GradientStop Color="#F4F2FF" Offset="1"/></LinearGradientBrush></Border.Background>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <Border Background="#FDFBFF" CornerRadius="20" Padding="12,7" HorizontalAlignment="Left"><TextBlock Text="✧  小工具，大灵感" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/></Border>
                  <TextBlock Text="好想法，&#x0a;值得被好好留下。" FontSize="28" FontWeight="Bold" LineHeight="40" Margin="0,22,0,12"/>
                  <TextBlock Text="截图 · 标注 · 分享，一气呵成。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,20"/>
                  <Button Content="▣   开始截图     Ctrl ⇧ 1" Style="{StaticResource PrimaryButton}" Click="CaptureRegion" HorizontalAlignment="Left"/>
                </StackPanel>
                <Grid Grid.Column="1" Margin="10,15,0,8">
                  <Ellipse Fill="#DCD1FF" Opacity=".55" Width="230" Height="200"/>
                  <Border Background="White" CornerRadius="14" Padding="20" Margin="5,36,0,20" RenderTransformOrigin=".5,.5">
                    <Border.RenderTransform><RotateTransform Angle="-5"/></Border.RenderTransform>
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity=".08" Color="#7355BF"/></Border.Effect>
                    <StackPanel><TextBlock Text="● ● ●" Foreground="#DCD2F9" FontSize="12"/><Border BorderBrush="#AB8EF3" BorderThickness="2" CornerRadius="8" Margin="0,17,0,14" Padding="18"><TextBlock Text="A little inspiration.&#x0a;随时留住一点灵感。" FontSize="15" FontWeight="SemiBold" LineHeight="29"/></Border><TextBlock Text="↗    ▢    T    ✎" Foreground="{StaticResource Accent}" FontSize="21" HorizontalAlignment="Center"/></StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </Border>
            <DockPanel Margin="0,0,0,15"><TextBlock Text="选择一种捕捉方式" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="全局快捷键 · Ctrl + Shift" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></DockPanel>
            <UniformGrid Columns="4" Margin="-5,0,-5,0">
              <Button Click="CaptureRegion" Padding="18,22" Margin="5" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▣" FontSize="28" Foreground="{StaticResource Accent}"/><TextBlock Text="区域截图" FontWeight="SemiBold" Margin="0,18,0,7"/><TextBlock Text="自由框选，精准捕捉" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="Ctrl ⇧ 1" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,18,0,0"/></StackPanel></Button>
              <Button Click="CaptureWindow" Padding="18,22" Margin="5" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▤" FontSize="28" Foreground="{StaticResource Accent}"/><TextBlock Text="窗口截图" FontWeight="SemiBold" Margin="0,18,0,7"/><TextBlock Text="点击窗口，捕捉可见画面" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="Ctrl ⇧ 2" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,18,0,0"/></StackPanel></Button>
              <Button Click="CaptureDisplay" Padding="18,22" Margin="5" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▱" FontSize="28" Foreground="{StaticResource Accent}"/><TextBlock Text="全屏截图" FontWeight="SemiBold" Margin="0,18,0,7"/><TextBlock Text="整个屏幕，一览无余" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="Ctrl ⇧ 3" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,18,0,0"/></StackPanel></Button>
              <Button Click="CaptureScroll" Padding="18,22" Margin="5" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="⇩" FontSize="28" Foreground="{StaticResource Accent}"/><TextBlock Text="滚动长截图" FontWeight="SemiBold" Margin="0,18,0,7"/><TextBlock Text="向下滚动，自动拼接" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="Ctrl ⇧ 4" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,18,0,0"/></StackPanel></Button>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,22,0,0"><DockPanel><Button Content="体验标注  ↗" DockPanel.Dock="Right" Click="TryEditor" BorderThickness="0" Foreground="{StaticResource Accent}" Padding="8,5"/><StackPanel><TextBlock Text="先试试，让灵感更清晰" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="用本地练习图体验箭头、文字、马赛克与导出。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
          </StackPanel>
        </ScrollViewer>
        <DockPanel x:Name="HistoryPage" Visibility="Collapsed">
          <StackPanel DockPanel.Dock="Top"><TextBlock Text="每一次捕捉，都有迹可循。" FontSize="29" FontWeight="Bold"/><TextBlock Text="保留最近 100 张原始截图；标注完成后请复制或另存。" Foreground="{StaticResource Muted}" Margin="0,10,0,20"/><DockPanel Margin="0,0,0,20"><Button Content="打开文件夹" DockPanel.Dock="Right" Click="OpenHistoryFolder" Margin="10,0,0,0"/><Button Content="清空历史" DockPanel.Dock="Right" Click="ClearHistory" Margin="10,0,0,0"/><TextBox x:Name="HistorySearch" TextChanged="SearchHistory" ToolTip="搜索截图方式、日期或文件名"/></DockPanel></StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="EmptyHistory" Text="还没有截图，试着捕捉一点灵感吧。" Foreground="{StaticResource Muted}" Margin="0,40" HorizontalAlignment="Center"/><WrapPanel x:Name="HistoryCards"/></StackPanel></ScrollViewer>
        </DockPanel>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="让截图更顺手。" FontSize="32" FontWeight="Bold"/><TextBlock Text="按你的习惯，调整每一个小细节。" Foreground="{StaticResource Muted}" Margin="0,10,0,30"/>
            <TextBlock Text="截图体验" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <CheckBox x:Name="AutoCopy" Content="截图后自动复制到剪贴板" Checked="SaveSettings" Unchecked="SaveSettings"/><TextBlock Text="打开标注编辑器的同时，复制原始截图。" Foreground="{StaticResource Muted}" FontSize="12" Margin="20,0,0,14"/>
              <Separator Margin="0,0,0,12"/><CheckBox x:Name="PlaySound" Content="截图完成时播放提示音" Checked="SaveSettings" Unchecked="SaveSettings"/><Separator Margin="0,14"/>
              <DockPanel><ComboBox x:Name="CaptureDelay" DockPanel.Dock="Right" SelectionChanged="DelayChanged"><ComboBoxItem Content="立即截图" Tag="0"/><ComboBoxItem Content="延时 3 秒" Tag="3"/><ComboBoxItem Content="延时 5 秒" Tag="5"/></ComboBox><TextBlock Text="截图延时" VerticalAlignment="Center"/></DockPanel>
              <Separator Margin="0,18,0,10"/><CheckBox x:Name="LoginLaunch" Content="登录 Windows 后启动（仅显示托盘图标）" Checked="ChangeLogin" Unchecked="ChangeLogin"/>
            </StackPanel></Border>
            <TextBlock Text="快捷键" FontSize="16" FontWeight="SemiBold" Margin="0,28,0,14"/>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="区域截图                           Ctrl + Shift + 1" Margin="0,0,0,15"/><TextBlock Text="窗口截图                           Ctrl + Shift + 2" Margin="0,0,0,15"/><TextBlock Text="全屏截图                           Ctrl + Shift + 3" Margin="0,0,0,15"/><TextBlock Text="滚动长截图                        Ctrl + Shift + 4"/><TextBlock Text="Esc 取消截图或滚动；关闭主窗口后快捷键仍可使用。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,20,0,0"/></StackPanel></Border>
            <TextBlock Text="拾光截图 LumaShot · Windows" FontWeight="SemiBold" Margin="0,28,0,8"/><TextBlock Text="原图仅保存在本机，无账号、无遥测、不上传图片。" Foreground="{StaticResource Muted}" FontSize="12"/>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,20"><Button Content="打开截图文件夹" Click="OpenHistoryFolder"/><Button Content="GitHub 项目" Click="OpenGitHub" Margin="10,0,0,0"/></StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Grid>
</Window>
